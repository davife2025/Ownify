{
  "name": "@ownify/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/*.test.ts src/agents/*.test.ts src/swarm/*.test.ts",
    "simulate": "tsx src/swarm/cli.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@ownify/shared": "workspace:*",
    "@supabase/supabase-js": "^2.45.0",
    "dotenv": "^16.4.0",
    "fastify": "^5.0.0",
    "near-api-js": "^5",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
